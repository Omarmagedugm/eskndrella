rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function owner(uid){return signedIn() && request.auth.uid == uid;}
  function publicRecord(){return resource.data.published == true && resource.data.verification == 'verified';}
  match /users/{uid} {
   allow read: if owner(uid);
   allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['displayName','photoURL','createdAt','updatedAt']) && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120 && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 1000;
   allow delete: if owner(uid);
  }
  match /user_roles/{uid} {allow read: if owner(uid); allow write: if false;}
  match /route_edges/{id} {allow read: if resource.data.published == true && resource.data.verified == true;allow write: if false;}
  match /{collection}/{id} {
   allow read: if collection in ['transport_modes','transport_lines','route_variants','stops','line_stops','service_status','fares','alerts','data_sources','app_settings','regions','city_places','city_outings','city_news','city_events','city_services','city_businesses','sports_clubs','sports_fixtures','sports_activities'] && publicRecord();
   allow write: if false;
  }
  // Privileged writes and private collection reads use authenticated callable Functions.
  match /{document=**} {allow read,write: if false;}
 }
}
