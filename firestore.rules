rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(d) {
      return d.keys().hasAll(['displayName', 'updatedAt']) &&
             d.keys().hasOnly(['displayName', 'updatedAt']) &&
             d.displayName is string &&
             d.displayName.size() <= 80 &&
             d.updatedAt == request.time;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(request.resource.data) && uidUnchanged();
      allow update: if isOwner(uid) && isValidUser(request.resource.data) && uidNotModified();
      allow delete: if isOwner(uid);
    }

    match /{collection}/{id} {
      allow read: if collection in [
        'transport_modes',
        'transport_lines',
        'route_variants',
        'stops',
        'line_stops',
        'service_status',
        'fares',
        'alerts',
        'data_sources',
        'app_settings'
      ] && resource.data.published == true && resource.data.verification == 'verified';
      allow write: if false;
    }

    match /route_edges/{id} {
      allow read: if resource.data.published == true && resource.data.verified == true;
      allow write: if false;
    }

    match /{collection}/{id} {
      allow read: if collection in [
        'community_reports',
        'contributor_applications',
        'contribution_submissions',
        'favorites',
        'saved_journeys'
      ] && isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if collection in [
        'community_reports',
        'contributor_applications',
        'contribution_submissions',
        'favorites',
        'saved_journeys'
      ] && isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
