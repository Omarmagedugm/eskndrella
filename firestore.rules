rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'megastudiodm@gmail.com' && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role in ['super_admin', 'admin'])
      );
    }

    function isEditor() {
      return isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'data_editor'
      );
    }

    function isModerator() {
      return isEditor() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'moderator'
      );
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function isValidUser(d) {
      return d.keys().hasAll(['displayName', 'updatedAt']) &&
             d.keys().hasOnly(['displayName', 'updatedAt']) &&
             d.displayName is string &&
             d.displayName.size() <= 80 &&
             d.updatedAt == request.time;
    }

    // Connection testing
    match /test/{docId} {
      allow read: if true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidUser(request.resource.data) && uidUnchanged();
      allow update: if isOwner(uid) && isValidUser(request.resource.data) && uidNotModified();
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /user_roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /admin_drafts/{id} {
      allow read, write: if isEditor();
    }

    match /data_versions/{id} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isModerator();
      allow create: if isModerator();
      allow update, delete: if false;
    }

    match /approved_contributors/{uid} {
      allow read: if isOwner(uid) || isModerator();
      allow write: if isAdmin();
    }

    match /contribution_reviews/{id} {
      allow read, create: if isModerator();
    }

    match /fare_history/{id} {
      allow read, create: if isAdmin();
    }

    match /{collection}/{id} {
      allow read: if collection in [
        'transport_modes',
        'transport_lines',
        'route_variants',
        'stops',
        'line_stops',
        'service_status',
        'fares',
        'alerts',
        'data_sources',
        'app_settings',
        'regions',
        'city_places',
        'city_news',
        'city_events',
        'city_services',
        'city_businesses'
      ] && ((resource.data.published == true && resource.data.verification == 'verified') || isEditor());
      allow write: if collection in [
        'transport_modes',
        'transport_lines',
        'route_variants',
        'stops',
        'line_stops',
        'service_status',
        'fares',
        'alerts',
        'data_sources',
        'app_settings',
        'regions',
        'city_places',
        'city_news',
        'city_events',
        'city_services',
        'city_businesses'
      ] && isAdmin();
    }

    match /route_edges/{id} {
      allow read: if (resource.data.published == true && resource.data.verified == true) || isEditor();
      allow write: if isAdmin();
    }

    match /{collection}/{id} {
      allow read: if collection in [
        'community_reports',
        'contributor_applications',
        'contribution_submissions',
        'favorites',
        'saved_journeys'
      ] && ((isAuthenticated() && resource.data.uid == request.auth.uid) || isModerator());
      allow create: if collection in [
        'community_reports',
        'contributor_applications',
        'contribution_submissions',
        'favorites',
        'saved_journeys'
      ] && isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if collection in [
        'community_reports',
        'contributor_applications',
        'contribution_submissions'
      ] && isModerator();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
